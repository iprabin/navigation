{
  "name": "app-navigation",
  "version": "0.1.0",
  "description": "Flat navigation for React Native: declare routes, get the navigators, deep links and back history for free.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "app-navigation-codegen": "bin/codegen.js"
  },
  "files": [
    "bin",
    "metro.js",
    "generated",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "check": "tsx test/linking.check.ts",
    "routes:types": "node bin/codegen.js",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md README.md && node bin/codegen.js --reset --out generated/routes.d.ts"
  },
  "keywords": [
    "react-native",
    "navigation",
    "deep-linking",
    "react-navigation"
  ],
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7",
    "@react-navigation/material-top-tabs": ">=7",
    "@react-navigation/native": ">=7",
    "@react-navigation/native-stack": ">=7",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "react-native-screens": ">=3",
    "react-native-pager-view": ">=6",
    "typescript": ">=5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "tsx": "^4.19.2"
  }
}
